{
  // Development of the community platform, in the endurance-manager.app account: it serves the test
  // communities only (fmt.endurance-manager.app), with its own database. Production is
  // wrangler.prod.jsonc.
  "name": "endurance-manager-dev",
  "main": "server/worker-with-migrations.mjs",
  "compatibility_date": "2026-09-07",
  "account_id": "880b4cbe0740cbc099a25c17773c0ec7",
  "keep_vars": true,
  "minify": true,
  "build": { "command": "npm run build:workers" },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // The route (more specific than production's *.endurance-manager.app/*) keeps fmt on this Worker.
  "routes": [
    { "pattern": "fmt.endurance-manager.app", "custom_domain": true },
    { "pattern": "fmt.endurance-manager.app/*", "zone_name": "endurance-manager.app" }
  ],
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "endurance-manager-dev",
      "database_id": "3fbdc526-3bc6-43e9-92d9-e699004bee4f",
      "migrations_dir": "migrations"
    }
  ],
  // Secrets set in the dashboard (never here): DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET, DISCORD_BOT_TOKEN,
  // ADMIN_DISCORD_IDS (the platform managers).
  "vars": {
    "APP_ORIGIN": "https://fmt.endurance-manager.app",
    "SITE_ENV": "development",
    // Used for real by a team: no « Version de test » banner (still out of search engines, own cookies).
    "TEST_BANNER": "off",
    "COMMUNITY": "fmt",
    // Communities platform: <slug>.endurance-manager.app, one sign-in for all of them.
    "BASE_DOMAIN": "endurance-manager.app"
  }
}
