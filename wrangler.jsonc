{
  "name": "app",
  "main": "server/worker-with-migrations.mjs",
  "compatibility_date": "2026-09-07",
  "keep_vars": true,
  "minify": true,
  "build": { "command": "npm run build:workers" },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fmt-endurance",
      "database_id": "6d85f5db-bf86-4af6-95f3-293b6e23c198",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "APP_ORIGIN": "https://app.endurance-manager.workers.dev",
    "SITE_ENV": "development"
  }
}
