<Project Sdk="Microsoft.NET.Sdk">
  <!-- Façade de GameReaderCommon.dll (SimHub) pour compiler le plugin sans SimHub (GitHub Actions) : seulement les noms
       que le plugin utilise, sans code. La DLL produite n'est jamais copiée chez les pilotes. Voir reference/README.md. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>GameReaderCommon</AssemblyName>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
