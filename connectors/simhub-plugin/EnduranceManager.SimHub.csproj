<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plugin SimHub des fiches combo d'Endurance Manager. Se compile sur un PC Windows où SimHub est installé :
       dotnet build -c Release   (ou -p:SimHubDir="D:\SimHub" si SimHub est ailleurs).
       La DLL produite se copie dans le dossier de SimHub (voir README.md). -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF Condition="'$(OS)' == 'Windows_NT'">true</UseWPF>
    <AssemblyName>EnduranceManager.SimHub</AssemblyName>
    <!-- The plugin's version: raised for each new build given to the pilots (release/plugin.json, README.md). -->
    <Version>2.6.0</Version>
    <!-- The commit in the build's identity (2.6.0+sha, shown « 2.6.0 (abc1234) » on the plugin's screen). -->
    <SourceRevisionId Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</SourceRevisionId>
    <RootNamespace>EnduranceManager.SimHub</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <SimHubDir Condition="'$(SimHubDir)' == ''">C:\Program Files (x86)\SimHub</SimHubDir>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <!-- SimHub installé (PC d'un pilote) : ses vraies DLL. Sinon (GitHub Actions, cloud) : la façade de reference/, mêmes
       signatures, jamais copiée chez les pilotes. -->
  <PropertyGroup>
    <UseSimHubFacade Condition="'$(UseSimHubFacade)' == '' And !Exists('$(SimHubDir)\SimHub.Plugins.dll')">true</UseSimHubFacade>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseSimHubFacade)' != 'true'">
    <Reference Include="SimHub.Plugins"><HintPath>$(SimHubDir)\SimHub.Plugins.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GameReaderCommon"><HintPath>$(SimHubDir)\GameReaderCommon.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SimHubDir)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseSimHubFacade)' == 'true'">
    <ProjectReference Include="reference\SimHub.Plugins\SimHub.Plugins.csproj" Private="false" />
    <ProjectReference Include="reference\GameReaderCommon\GameReaderCommon.csproj" Private="false" />
    <!-- La version que SimHub fournit (13.0.0.0, comme la sienne) ; la DLL n'est pas copiée. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <!-- Les tests et la façade ont leurs propres projets : pas compilés dans la DLL du plugin. -->
  <ItemGroup>
    <Compile Remove="reference\**;tests\**;bin\**;obj\**" />
    <None Remove="reference\**;tests\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- L'installeur en double-clic, à donner aux pilotes avec la DLL. -->
    <None Update="Installer le plugin.cmd" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Convertir un dash NeoRed.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Hors Windows (compilation dans le cloud), WPF par ses DLL de référence : le plugin n'a pas de XAML. -->
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>
  <Target Name="EmCommit" BeforeTargets="InitializeSourceControlInformation;GetAssemblyVersion;GenerateAssemblyInfo" Condition="'$(SourceRevisionId)' == ''">
    <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" IgnoreExitCode="true" StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="SourceRevisionId" />
    </Exec>
  </Target>
</Project>
