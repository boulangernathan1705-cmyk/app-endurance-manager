{
  "name": "endurance-manager-prod",
  "main": "server/worker-with-migrations.mjs",
  "compatibility_date": "2026-09-07",
  "keep_vars": true,
  "minify": true,
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "redact_query_string": true},
  "build": { "command": "npm run build:workers" },
  "triggers": {
    "crons": ["*/15 * * * *", "*/2 * * * *", "*/5 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/index*", "/api/*", "/telemetry/*", "/discord/*", "/manifest.webmanifest", "/app-icon.png",
      "/lmu*", "/iracing*", "/events*", "/members*", "/help*", "/about*", "/legal*", "/privacy*", "/changelog*", "/circuit-credits*",
      "/demande-communaute*", "/diagnostics*", "/fiches-combo*", "/mur*", "/charte*",
      "!/front/*", "!/shared/*", "!/images/*", "!/app.css", "!/app.js", "!/crew-builder.js", "!/help.js", "!/help.css", "!/privacy.css", "!/sw.js"]
  },
  "routes": [
    { "pattern": "endurance-manager.app", "custom_domain": true },
    { "pattern": "*.endurance-manager.app/*", "zone_name": "endurance-manager.app" }
  ],
  "durable_objects": { "bindings": [{ "name": "LIVE", "class_name": "LiveRoom" }] },
  "migrations": [{ "tag": "v1-live-room", "new_sqlite_classes": ["LiveRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "endurance-manager-prod",
      "database_id": "bf277ee5-ddf5-48a9-a18d-0ba2b0f49120",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "REQUEST_METRICS": "on",
    "APP_ORIGIN": "https://endurance-manager.app",
    "BASE_DOMAIN": "endurance-manager.app"
  }
}
